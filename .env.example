# ---- Server ----
PORT=5000
NODE_ENV=development

# ---- Database ----
MONGO_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/cosmetics-store

# ---- Auth (JWT) ----
JWT_SECRET=replace_with_a_long_random_string
JWT_REFRESH_SECRET=replace_with_a_different_long_random_string
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ---- Admin (for initial setup) ----
ADMIN_EMAIL=
ADMIN_PASS=

# --- Product Settings ----
NEW_ARRIVAL_WINDOW_DAYS=
RETURN_WINDOW_DAYS=

# --- Upstash Redis (rate limiting) ----
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ---- Session (required by Passport even in JWT-based flows) ----
SESSION_SECRET=replace_with_a_long_random_string

# ---- Google OAuth (Passport) ----
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# ---- Frontend URLs (for redirects + CORS) ----
CLIENT_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001

# ---- Cloudinary (product/banner images) ----
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---- Razorpay ----
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ---- Shiprocket ----
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=

# ---- Email (order confirmations) ----
EMAIL_FROM=orders@yourstore.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
RESEND_API_KEY=
